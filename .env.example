# Copy this file to .env and fill in the values. Never commit .env.

# From https://developers.kite.trade -> your app
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Must match the Redirect URL registered on the Kite developer console
KITE_REDIRECT_URL=http://127.0.0.1:5000/callback

# From https://console.anthropic.com (leave unset if you use `ant auth login`)
ANTHROPIC_API_KEY=your_anthropic_api_key
COPILOT_MODEL=claude-opus-5-5

# Set to 1 to preview the UI with sample portfolio data (no Zerodha login needed)
DEMO_MODE=0

# ---- Hosting under a path, e.g. https://techswitch.in/equity/ ----
# BASE_PATH=/equity
# KITE_REDIRECT_URL=https://techswitch.in/equity/callback
# Long random string, same value as the Cloudflare Worker's ORIGIN_SECRET
# ORIGIN_SECRET=
# Folder for the cached Kite token (a persistent volume in containers)
# DATA_DIR=/data
