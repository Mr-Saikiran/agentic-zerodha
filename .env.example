# Deployment settings only. Each user enters their own Kite API key/secret and AI provider key
# in the app; those are never configured here. Copy to .env for local runs. Never commit .env.

# Encrypts session cookies (users' saved keys). Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it a random one is used and everyone has to re-enter keys after a restart.
SESSION_SECRET=

# URL prefix when hosted under a path, e.g. https://techswitch.in/equity/
# BASE_PATH=/equity

# Redirect URL shown to users for their Kite Connect app. Default: derived from the request,
# e.g. http://127.0.0.1:5000/callback locally.
# KITE_REDIRECT_URL=https://techswitch.in/equity/callback

# Optional: only accept requests carrying this X-Origin-Auth header (set the same on the Cloudflare Worker).
# ORIGIN_SECRET=

# Self-hosting with docker-compose + Cloudflare Tunnel: the token from
# Zero Trust → Networks → Tunnels → your tunnel → Install connector.
# CLOUDFLARE_TUNNEL_TOKEN=

# Self-hosting only: allow an http:// or private-network AI base URL, e.g. Ollama at http://localhost:11434/v1.
# Keep this off on a public server.
# ALLOW_LOCAL_AI_URL=1
