# Copy this file to .env and fill in the values. Never commit .env.

# From https://developers.kite.trade -> your app
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# Must match the Redirect URL registered on the Kite developer console
KITE_REDIRECT_URL=http://127.0.0.1:5000/callback

# ---- AI provider: set ONE of these ----
# Gemini (free tier): key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Claude: key from https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Optional. anthropic | gemini | openai. Defaults to gemini when only GEMINI_API_KEY is set.
# LLM_PROVIDER=gemini
# Optional model override (defaults: gemini-flash-latest / claude-opus-5-5)
# COPILOT_MODEL=
# For LLM_PROVIDER=openai (OpenRouter, Groq, OpenCode, Ollama...):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=

# Set to 1 to preview the UI with sample portfolio data (no Zerodha login needed)
DEMO_MODE=0

# ---- Hosting under a path, e.g. https://techswitch.in/equity/ ----
# BASE_PATH=/equity
# KITE_REDIRECT_URL=https://techswitch.in/equity/callback
# Long random string, same value as the Cloudflare Worker's ORIGIN_SECRET
# ORIGIN_SECRET=
# Folder for the cached Kite token (a persistent volume in containers)
# DATA_DIR=/data
